# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Env
.env

# IDE
.idea/

# Label Studio local database/storage
label_studio_data/
mydata/

# DVC internals
.dvc/cache/
.dvc/tmp/

# Large data is tracked by DVC, not Git
data/raw/**
data/interim/**
data/labeled/**
data/processed/**

# Keep DVC pointer files
!data/**/*.dvc

# Keep directory placeholders
!data/.gitignore
!data/raw/
!data/raw/.gitignore
!data/interim/
!data/interim/.gitignore
!data/labeled/
!data/labeled/.gitignore
!data/processed/
!data/processed/.gitignore

# Keep lightweight reference/config files
!data/reference/
!data/reference/**
!data/labeling/
!data/labeling/**
!data/labeling/tasks/
!data/labeling/tasks/*.json
!data/labeling/tasks/*.jsonl

# Models/artifacts
models/
artifacts/
.DS_Store